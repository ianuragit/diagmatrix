---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryModal from '../components/InquiryModal.astro';

export interface Props {
  title: string;
  description: string;
  /** Path (without base) used for the canonical URL; defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Extra <head> content (JSON-LD, meta refresh, alternates). */
  bodyClass?: string;
}
const { title, description, canonicalPath, noindex = false, bodyClass } = Astro.props;
const canonical = new URL(
  canonicalPath
    ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${canonicalPath}`
    : Astro.url.pathname,
  Astro.site,
).href;
---

<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0F2A43" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <InquiryModal />
    <div id="basket-live" class="visually-hidden" aria-live="polite"></div>
    <script>
      import { initBasket } from '../scripts/basket';
      import { initInquiry } from '../scripts/inquiry';
      import { initHeaderSearch } from '../scripts/search';
      initBasket();
      initInquiry();
      initHeaderSearch();
    </script>
  </body>
</html>
<style is:global>
  main:focus {
    outline: none;
  }
</style>
