{
  "name": "diagmatrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static directory of in-vitro diagnostic products, built from a polite scraping pipeline and published with Astro on GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "crawl": "tsx pipeline/cli.ts crawl",
    "parse": "tsx pipeline/cli.ts parse",
    "build-data": "tsx pipeline/cli.ts build-data",
    "validate": "tsx pipeline/cli.ts validate",
    "report": "tsx pipeline/cli.ts report",
    "privacy-check": "tsx pipeline/cli.ts privacy-check",
    "quality": "tsx pipeline/cli.ts audit",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "linkcheck": "tsx scripts/linkcheck.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "^7.4.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.7",
    "cheerio": "^1.2.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "serve-handler": "^6.1.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
