---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryModal from '../components/InquiryModal.astro';
import { site } from '../lib/site';
import { abs, ldJson } from '../lib/seo';

export interface Props {
  title: string;
  description: string;
  /** Path (without base) used for the canonical URL; defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  bodyClass?: string;
  /** Open Graph image path (without base); defaults to the site card. */
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  /** JSON-LD objects rendered into <head>. */
  jsonLd?: unknown[];
  /** Machine-readable twin of this page (e.g. /products/{slug}.json). */
  alternateJson?: string;
}
const {
  title,
  description,
  canonicalPath,
  noindex = false,
  bodyClass,
  ogImage = '/og/default.png',
  ogType = 'website',
  jsonLd = [],
  alternateJson,
} = Astro.props;
const ogUrl = abs(ogImage, Astro.site);
const canonical = new URL(
  canonicalPath
    ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${canonicalPath}`
    : Astro.url.pathname,
  Astro.site,
).href;
---

<!doctype html>
<html lang="en" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0F2A43" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {alternateJson && (
      <link rel="alternate" type="application/json" href={abs(alternateJson, Astro.site)} />
    )}
    <link
      rel="alternate"
      type="text/plain"
      title="LLM summary"
      href={abs('/llms.txt', Astro.site)}
    />
    {jsonLd.map((d) => (
      <script type="application/ld+json" set:html={ldJson(d)} />
    ))}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <InquiryModal />
    <div id="basket-live" class="visually-hidden" aria-live="polite"></div>
    <script>
      import { initBasket } from '../scripts/basket';
      import { initInquiry } from '../scripts/inquiry';
      import { initHeaderSearch } from '../scripts/search';
      initBasket();
      initInquiry();
      initHeaderSearch();
    </script>
  </body>
</html>
<style is:global>
  main:focus {
    outline: none;
  }
</style>
