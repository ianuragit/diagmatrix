---
import { url } from '../lib/url';
import { ldJson } from '../lib/seo';
export interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...items];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    ...(it.href ? { item: new URL(url(it.href), Astro.site).href } : {}),
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {all.map((it, i) => (
      <li>
        {it.href && i < all.length - 1 ? (
          <a href={url(it.href)}>{it.label}</a>
        ) : (
          <span aria-current="page">{it.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={ldJson(ld)} />
<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    list-style: none;
    padding: 0;
    margin: var(--s-4) 0;
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: var(--s-1);
  }
</style>
