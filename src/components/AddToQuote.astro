---
import { url } from '../lib/url';
export interface Props {
  id: string;
  name: string;
  brand: string | null;
  catalogue: string | null;
  size?: 'sm' | 'md';
}
const { id, name, brand, catalogue, size = 'md' } = Astro.props;
---

<button
  type="button"
  class={`btn btn-teal${size === 'sm' ? ' btn-sm' : ''}`}
  data-add-to-quote
  data-id={id}
  data-name={name}
  data-brand={brand ?? ''}
  data-catalogue={catalogue ?? ''}
  data-basket-url={url('/basket/')}
  aria-pressed="false"
>
  <span data-label>Add to quote</span>
</button>
